# ============================================================
# APNAJOTISH ENVIRONMENT VARIABLES
# Copy this file to .env and fill in your actual values
# ============================================================

# SERVER CONFIGURATION
PORT=3000
NODE_ENV=development

# ============================================================
# GROQ API (FREE - Recommended for launch!)
# Get API key from: https://console.groq.com
# Free tier: 9,000 requests/month (enough for 500+ users)
# Cost: FREE! Always free for reasonable usage
# ============================================================
GROQ_API_KEY=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

# ============================================================
# CLAUDE AI (Optional - Paid alternative)
# Get API key from: https://console.anthropic.com
# Cost: ₹300-2,000/month
# Use if you want to switch later for higher quality
# ============================================================
# CLAUDE_API_KEY=sk-ant-v0-xxxxx

# ============================================================
# GOOGLE GEMINI (Optional - Use if legacy key is restored)
# Get API key from: https://ai.google.dev
# Cost: FREE tier (1,500 requests/day)
# Use after requesting legacy key restoration from Google
# ============================================================
# GOOGLE_API_KEY=AIzaSy...

# ============================================================
# SUPABASE DATABASE (Optional - Add later)
# Get details from: https://supabase.com
# Create new project, then copy from project settings
# ============================================================
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================================
# RAZORPAY PAYMENTS (Optional - Add when you want payments)
# Get keys from: https://dashboard.razorpay.com
# Settings → API Keys (under Account & Billing)
# ============================================================
# RAZORPAY_KEY_ID=rzp_live_xxxxx
# RAZORPAY_KEY_SECRET=xxxx

# ============================================================
# BREVO EMAIL SERVICE (Optional - Add later)
# Get API key from: https://app.brevo.com/settings/account/api
# Create new API key (REST API v3)
# ============================================================
# BREVO_API_KEY=xxxxxxxxxxx
# BREVO_FROM_EMAIL=connect@apnajotish.com
# BREVO_FROM_NAME=Apna Jotish

# ============================================================
# JWT SECRET (For user authentication - Optional)
# Generate random string (min 32 chars)
# ============================================================
# JWT_SECRET=your-super-secret-jwt-key-at-least-32-characters-long

# ============================================================
# FRONTEND URL (For CORS)
# ============================================================
FRONTEND_URL=http://localhost:3000
PRODUCTION_URL=https://apnajotish.com

# ============================================================
# DATABASE CREDENTIALS (If using PostgreSQL directly - Optional)
# ============================================================
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_NAME=apnajotish

# ============================================================
# LOGGING
# ============================================================
LOG_LEVEL=info
